# Copy to .env

# Postgres (source + serve can share one instance with two DBs)
POSTGRES_USER=retail
POSTGRES_PASSWORD=retail
POSTGRES_DB=retail_source

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ClickHouse
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_DB=retail_analytics

# Hasura
HASURA_GRAPHQL_ADMIN_SECRET=hasura_admin_secret

# Superset
SUPERSET_SECRET_KEY=superset_change_me_to_a_long_random_string